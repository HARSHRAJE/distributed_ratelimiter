# Reference values for local runs. For Compose, append the required variables
# to the existing repository-root .env rather than replacing it.
AI_CONTROLLER_API_KEY=replace-with-a-random-secret-at-least-32-characters
AI_CONTROLLER_PROMETHEUS_URL=http://localhost:9090
AI_CONTROLLER_SERVICE_KEYS=orders-service
AI_CONTROLLER_COLLECTION_INTERVAL_SECONDS=15
AI_CONTROLLER_STALE_AFTER_SECONDS=60
AI_CONTROLLER_AGGREGATION_WINDOW_SECONDS=300
AI_CONTROLLER_PROMETHEUS_TIMEOUT_SECONDS=5
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rate_limiter
DB_USERNAME=rate_limiter_app
DB_PASSWORD=replace-with-the-postgres-password

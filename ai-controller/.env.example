# Reference values for local runs. For Compose, append the required variables
# to the existing repository-root .env rather than replacing it.
AI_CONTROLLER_API_KEY=replace-with-a-random-secret-at-least-32-characters
AI_CONTROLLER_PROMETHEUS_URL=http://localhost:9090
AI_CONTROLLER_SERVICE_KEYS=orders-service
AI_CONTROLLER_COLLECTION_INTERVAL_SECONDS=15
AI_CONTROLLER_STALE_AFTER_SECONDS=60
AI_CONTROLLER_AGGREGATION_WINDOW_SECONDS=300
AI_CONTROLLER_PROMETHEUS_TIMEOUT_SECONDS=5
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rate_limiter
DB_USERNAME=rate_limiter_app
DB_PASSWORD=replace-with-the-postgres-password
AI_CONTROLLER_POLICY_SERVICE_URL=http://localhost:8081
AI_CONTROLLER_POLICY_SERVICE_API_KEY=replace-with-a-random-secret-at-least-32-characters
POLICY_EXECUTION_API_KEY=use-the-same-secret-as-AI_CONTROLLER_POLICY_SERVICE_API_KEY
AI_CONTROLLER_ADMIN_API_KEY=replace-with-a-random-secret-at-least-32-characters
AI_CONTROLLER_ROLLBACK_P95_THRESHOLD_MS=500
AI_CONTROLLER_ROLLBACK_P95_CONSECUTIVE_WINDOWS=3
AI_CONTROLLER_ROLLBACK_5XX_THRESHOLD_PERCENT=5
AI_CONTROLLER_ROLLBACK_5XX_CONSECUTIVE_WINDOWS=2
AI_CONTROLLER_ROLLBACK_CRITICAL_5XX_PERCENT=20
AI_CONTROLLER_ROLLBACK_CPU_THRESHOLD_PERCENT=90
AI_CONTROLLER_ROLLBACK_CPU_CONSECUTIVE_WINDOWS=3
AI_CONTROLLER_ROLLBACK_QUEUE_DEPTH_THRESHOLD=100
AI_CONTROLLER_ROLLBACK_QUEUE_GROWTH_WINDOWS=3
AI_CONTROLLER_ROLLBACK_THROUGHPUT_DROP_PERCENT=30
AI_CONTROLLER_ROLLBACK_THROUGHPUT_CONSECUTIVE_WINDOWS=3
AI_CONTROLLER_ROLLBACK_OBSERVATION_PERIOD_SECONDS=60
AI_CONTROLLER_ROLLBACK_REDIS_SYNC_TIMEOUT_SECONDS=60
AI_CONTROLLER_ROLLBACK_COOLDOWN_SECONDS=3600
AI_CONTROLLER_ROLLBACK_MAX_ATTEMPTS_PER_HOUR=2
AI_CONTROLLER_ROLLBACK_MINIMUM_HEALTHY_WINDOWS=5
AI_CONTROLLER_ROLLBACK_TELEMETRY_MAX_AGE_SECONDS=60
AI_CONTROLLER_BREAKER_FAILURE_THRESHOLD=3
AI_CONTROLLER_BREAKER_RECOVERY_TIMEOUT_SECONDS=300
AI_CONTROLLER_BREAKER_HALF_OPEN_MAX_CALLS=1
AI_CONTROLLER_BREAKER_SUCCESS_THRESHOLD=1
AI_CONTROLLER_BREAKER_RECOVERY_MAX_CHANGE_PERCENT=2
AI_CONTROLLER_BREAKER_TELEMETRY_MAX_AGE_SECONDS=60
AI_CONTROLLER_BREAKER_FORECAST_FAILURE_THRESHOLD=3
AI_CONTROLLER_BREAKER_FORECAST_WAPE_MAX_PERCENT=50
AI_CONTROLLER_BREAKER_POLICY_FAILURE_THRESHOLD=3
AI_CONTROLLER_BREAKER_REDIS_FAILURE_THRESHOLD=3
AI_CONTROLLER_BREAKER_EXECUTION_FAILURE_THRESHOLD=3
AI_CONTROLLER_BREAKER_ROLLBACK_LIMIT=2
AI_CONTROLLER_BREAKER_ROLLBACK_WINDOW_SECONDS=1800
AI_CONTROLLER_BENCHMARK_TARGET_URL=http://host.docker.internal:8080
AI_CONTROLLER_BENCHMARK_ALLOWED_HOSTS=localhost:8080,host.docker.internal:8080,gateway:8080
AI_CONTROLLER_BENCHMARK_ROUTE_PATHS=/
AI_CONTROLLER_BENCHMARK_K6_BINARY=k6
AI_CONTROLLER_BENCHMARK_WORKER_POLL_SECONDS=2
AI_CONTROLLER_BENCHMARK_MAX_DURATION_SECONDS=3600
AI_CONTROLLER_BENCHMARK_MAX_RPS=100
AI_CONTROLLER_BENCHMARK_TENANT_TOKENS=
AI_CONTROLLER_GIT_COMMIT=replace-with-tested-git-commit
